# ключи (файл radar.env в .gitignore; права 600)
ANTHROPIC_API_KEY=
RADAR_TG_TOKEN=            # бот канала
RADAR_CHANNEL=@your_channel
RADAR_OWNER_BOT_TOKEN=     # бот для личных уведомлений владельцу (можно тот же)
RADAR_OWNER_CHAT_ID=

# модели и бюджет
RADAR_MODEL=claude-sonnet-5
RADAR_DAILY_MODEL=claude-fable-5-1
RADAR_DIGEST_MODEL=claude-fable-5-1
RADAR_BUDGET_USD=35
RADAR_BUDGET_START=2026-09-11
RADAR_BUDGET_DAYS=45
RADAR_EVENING_BUDGET=0.8
RADAR_FULL_REVIEW=1
RADAR_ESSAY_MAX_WEEK=3
RADAR_HOLD_MIN=15

# рендер и сайт
RADAR_CHROME=/usr/bin/chromium
RADAR_POST_MODE=photo
RADAR_PUBLIC_BASE=https://example.org
RADAR_SITE_LOCAL=/var/www/example.org   # локальная папка сайта; или RADAR_SITE_FTP=on + RADAR_FTP_*
RADAR_SITE_FTP=off
